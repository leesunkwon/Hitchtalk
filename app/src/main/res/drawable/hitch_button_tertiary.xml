<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/hitch_ripple">
    <item android:id="@android:id/mask">
        <shape>
            <solid android:color="@android:color/white" />
            <corners android:radius="@dimen/hitch_control_radius" />
        </shape>
    </item>
    <item>
        <selector>
            <item android:state_focused="true">
                <shape>
                    <solid android:color="@color/hitch_brand_weak" />
                    <corners android:radius="@dimen/hitch_control_radius" />
                    <stroke android:width="2dp" android:color="@color/hitch_focus_ring" />
                </shape>
            </item>
            <item android:drawable="@android:color/transparent" />
        </selector>
    </item>
</ripple>

<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape>
            <solid android:color="@color/hitch_disabled_surface" />
            <corners android:radius="@dimen/hitch_control_radius" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape>
            <solid android:color="@color/hitch_brand_pressed" />
            <corners android:radius="@dimen/hitch_control_radius" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape>
            <solid android:color="@color/hitch_brand_solid" />
            <corners android:radius="@dimen/hitch_control_radius" />
            <stroke android:width="2dp" android:color="@color/hitch_on_accent" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/hitch_brand_solid" />
            <corners android:radius="@dimen/hitch_control_radius" />
        </shape>
    </item>
</selector>

<resources>
    <style name="HitchSettingsRow">
        <item name="android:background">@drawable/hitch_settings_row</item>
        <item name="android:padding">@dimen/hitch_gutter</item>
        <item name="android:layout_marginBottom">@dimen/hitch_space</item>
    </style>
    <style name="HitchSettingsTab" parent="HitchButton.Compact">
        <item name="android:background">@drawable/hitch_settings_tab</item>
        <item name="android:textColor">@color/hitch_settings_tab_label</item>
        <item name="android:gravity">start|center_vertical</item>
        <item name="android:paddingHorizontal">@dimen/hitch_gutter</item>
    </style>
    <style name="HitchSettingsSegment" parent="HitchButton.Compact">
        <item name="android:background">@drawable/hitch_settings_segment</item>
        <item name="android:textColor">@color/hitch_button_secondary_label</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingHorizontal">@dimen/hitch_space</item>
    </style>
    <style name="HitchSettingsAction" parent="HitchButton.Compact">
        <item name="android:paddingHorizontal">@dimen/hitch_gutter</item>
    </style>
</resources>

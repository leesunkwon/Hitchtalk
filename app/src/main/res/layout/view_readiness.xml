<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/hitch_callout_informative"
    android:orientation="vertical"
    android:padding="@dimen/hitch_callout_padding"
    android:visibility="gone">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="top"
        android:orientation="horizontal">
        <ImageView
            android:id="@+id/readiness_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginTop="2dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_hitch_status" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/hitch_space"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:id="@+id/title"
                style="@style/HitchSectionTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:accessibilityLiveRegion="polite" />

            <TextView
                android:id="@+id/detail"
                style="@style/HitchCaption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/hitch_space" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/action"
                style="@style/HitchButton.Outline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/hitch_space"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>

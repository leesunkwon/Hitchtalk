<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <com.kotlinsun.hitchtalk.ui.PleosColumns
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:baselineAligned="false"
        app:columnMinWidth="@dimen/hitch_settings_fields_min_width"
        android:layout_marginBottom="@dimen/hitch_gutter">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/back"
                style="@style/HitchButton.Compact"
                android:layout_width="@dimen/hitch_header_button_height"
                android:layout_height="@dimen/hitch_header_button_height"
                android:text="@string/secondary_back_symbol"
                android:contentDescription="@string/hitch_back"
                android:padding="0dp" />
            <TextView
                style="@style/HitchTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/hitch_settings_title"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/hitch_space"
                android:accessibilityHeading="true" />
        </LinearLayout>
        <TextView
            style="@style/HitchCaption"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/settings_design_parked"
            android:layout_weight="1"
            android:gravity="end|center_vertical" />
    </com.kotlinsun.hitchtalk.ui.PleosColumns>
    <com.kotlinsun.hitchtalk.ui.SettingsPanelLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">
        <HorizontalScrollView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:fillViewport="true"
            android:scrollbars="none">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:id="@+id/settings_navigation">
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/settings_tab_difficulty"
                    style="@style/HitchSettingsTab"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_design_difficulty" />
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/settings_tab_voice"
                    style="@style/HitchSettingsTab"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_design_voice" />
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/settings_tab_memory"
                    style="@style/HitchSettingsTab"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_design_memory" />
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/settings_tab_data"
                    style="@style/HitchSettingsTab"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_design_data" />
            </LinearLayout>
        </HorizontalScrollView>
        <ScrollView
            android:id="@+id/settings_scroll"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="3"
            android:clipToPadding="false"
            android:fillViewport="true">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:id="@+id/settings_difficulty_section">
                    <com.kotlinsun.hitchtalk.ui.PleosColumns
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:baselineAligned="false"
                        app:columnMinWidth="@dimen/hitch_settings_fields_min_width"
                        style="@style/HitchSettingsRow">
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_weight="1">
                            <TextView
                                style="@style/HitchSectionTitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/settings_design_difficulty" />
                            <TextView
                                style="@style/HitchCaption"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/settings_design_difficulty_note" />
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/hitch_gutter"
                            android:orientation="horizontal"
                            android:background="@drawable/hitch_button_secondary"
                            android:padding="4dp">
                            <androidx.appcompat.widget.AppCompatButton
                                android:id="@+id/settings_level_easy"
                                style="@style/HitchSettingsSegment"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:text="@string/settings_design_easy"
                                android:layout_weight="1" />
                            <androidx.appcompat.widget.AppCompatButton
                                android:id="@+id/settings_level_normal"
                                style="@style/HitchSettingsSegment"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:text="@string/settings_design_normal"
                                android:layout_weight="1" />
                            <androidx.appcompat.widget.AppCompatButton
                                android:id="@+id/settings_level_challenge"
                                style="@style/HitchSettingsSegment"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:text="@string/settings_design_challenge"
                                android:layout_weight="1" />
                        </LinearLayout>
                    </com.kotlinsun.hitchtalk.ui.PleosColumns>
                    <Spinner
                        android:id="@+id/level"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:importantForAccessibility="no"
                        android:visibility="gone" />
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        style="@style/HitchSettingsRow"
                        android:gravity="center_vertical">
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_weight="1">
                            <TextView
                                style="@style/HitchSectionTitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/settings_design_rate" />
                            <TextView
                                style="@style/HitchCaption"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/settings_design_rate_note" />
                        </LinearLayout>
                        <TextView
                            style="@style/HitchBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/settings_design_rate_value"
                            android:layout_marginStart="@dimen/hitch_space" />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        style="@style/HitchSettingsRow"
                        android:gravity="center_vertical">
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_weight="1">
                            <TextView
                                style="@style/HitchSectionTitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/settings_design_greeting" />
                            <TextView
                                style="@style/HitchCaption"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/settings_design_greeting_note" />
                        </LinearLayout>
                        <androidx.appcompat.widget.SwitchCompat
                            android:id="@+id/greeting"
                            android:layout_width="wrap_content"
                            android:layout_height="@dimen/hitch_header_button_height"
                            android:layout_marginStart="@dimen/hitch_space"
                            android:contentDescription="@string/settings_design_greeting" />
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:id="@+id/settings_voice_section"
                    android:visibility="gone">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        style="@style/HitchSettingsRow">
                        <TextView
                            style="@style/HitchSectionTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/refine_voice_section" />
                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/open_setup"
                            style="@style/HitchSettingsAction"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/refine_open_voice_settings"
                            android:layout_marginTop="@dimen/hitch_space"
                            android:gravity="start|center_vertical" />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        style="@style/HitchSettingsRow">
                        <TextView
                            style="@style/HitchSectionTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/microphone_test_title" />
                        <TextView
                            style="@style/HitchCaption"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/microphone_test_summary" />
                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/microphone_test"
                            style="@style/HitchSettingsAction"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/microphone_test_open"
                            android:layout_marginTop="@dimen/hitch_space" />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        style="@style/HitchSettingsRow"
                        android:id="@+id/open_ai_key_settings"
                        android:visibility="gone">
                        <TextView
                            style="@style/HitchSectionTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/openai_key_title" />
                        <TextView
                            style="@style/HitchBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/openai_key_missing"
                            android:id="@+id/open_ai_key_status"
                            android:layout_marginTop="@dimen/hitch_space"
                            android:accessibilityLiveRegion="polite" />
                        <TextView
                            style="@style/HitchCaption"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/openai_key_usage"
                            android:id="@+id/open_ai_key_usage"
                            android:layout_marginTop="@dimen/hitch_space" />
                        <TextView
                            style="@style/HitchCaption"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/openai_check_note"
                            android:id="@+id/open_ai_connection_note"
                            android:layout_marginTop="@dimen/hitch_space"
                            android:visibility="gone" />
                        <com.kotlinsun.hitchtalk.ui.PleosColumns
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:baselineAligned="false"
                            app:columnMinWidth="@dimen/hitch_action_row_min_width"
                            android:layout_marginTop="@dimen/hitch_space">
                            <androidx.appcompat.widget.AppCompatButton
                                android:id="@+id/open_ai_key_edit"
                                style="@style/HitchSettingsAction"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:text="@string/openai_key_add"
                                android:layout_weight="1" />
                            <androidx.appcompat.widget.AppCompatButton
                                android:id="@+id/open_ai_connection_check"
                                style="@style/HitchSettingsAction"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:text="@string/openai_check_action"
                                android:layout_weight="1"
                                android:layout_marginStart="@dimen/hitch_space"
                                android:visibility="gone" />
                        </com.kotlinsun.hitchtalk.ui.PleosColumns>
                        <TextView
                            style="@style/HitchCallout"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/openai_check_checking"
                            android:id="@+id/open_ai_connection_status"
                            android:layout_marginTop="@dimen/hitch_space"
                            android:accessibilityLiveRegion="polite"
                            android:visibility="gone" />
                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/open_ai_key_remove"
                            style="@style/HitchButton.Danger"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/openai_key_remove"
                            android:layout_marginTop="@dimen/hitch_space"
                            android:visibility="gone" />
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:id="@+id/settings_memory_section"
                    android:visibility="gone">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        style="@style/HitchSettingsRow"
                        android:id="@+id/settings_traveler_row">
                        <TextView
                            style="@style/HitchSectionTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/design_traveler_choice"
                            android:labelFor="@id/traveler_choice" />
                        <Spinner
                            android:id="@+id/traveler_choice"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/hitch_space"
                            android:background="@drawable/hitch_spinner_field"
                            android:minHeight="@dimen/hitch_header_button_height"
                            android:paddingStart="@dimen/hitch_gutter"
                            android:paddingEnd="44dp"
                            android:prompt="@string/design_traveler_choice"
                            android:spinnerMode="dialog" />
                    </LinearLayout>
                    <com.kotlinsun.hitchtalk.ui.PleosColumns
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:baselineAligned="false"
                        app:columnMinWidth="@dimen/hitch_settings_fields_min_width"
                        style="@style/HitchSettingsRow">
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_weight="1">
                            <TextView
                                style="@style/HitchSectionTitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/settings_design_memory_alex" />
                            <TextView
                                style="@style/HitchCaption"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/collection_memory_empty"
                                android:id="@+id/settings_alex_memory_summary"
                                android:ellipsize="end"
                                android:maxLines="2" />
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/hitch_space"
                            android:orientation="horizontal">
                            <androidx.appcompat.widget.AppCompatButton
                                android:id="@+id/alex_memory"
                                style="@style/HitchSettingsAction"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/settings_design_edit"
                                android:contentDescription="@string/settings_design_edit_alex" />
                            <androidx.appcompat.widget.AppCompatButton
                                android:id="@+id/settings_alex_memory_delete"
                                style="@style/HitchSettingsAction"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/settings_design_delete"
                                android:layout_marginStart="@dimen/hitch_space"
                                android:contentDescription="@string/settings_design_delete_alex" />
                        </LinearLayout>
                    </com.kotlinsun.hitchtalk.ui.PleosColumns>
                    <com.kotlinsun.hitchtalk.ui.PleosColumns
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:baselineAligned="false"
                        app:columnMinWidth="@dimen/hitch_settings_fields_min_width"
                        style="@style/HitchSettingsRow">
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_weight="1">
                            <TextView
                                style="@style/HitchSectionTitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/settings_design_memory_sara" />
                            <TextView
                                style="@style/HitchCaption"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/collection_memory_empty"
                                android:id="@+id/settings_sara_memory_summary"
                                android:ellipsize="end"
                                android:maxLines="2" />
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/hitch_space"
                            android:orientation="horizontal">
                            <androidx.appcompat.widget.AppCompatButton
                                android:id="@+id/sara_memory"
                                style="@style/HitchSettingsAction"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/settings_design_edit"
                                android:contentDescription="@string/settings_design_edit_sara" />
                            <androidx.appcompat.widget.AppCompatButton
                                android:id="@+id/settings_sara_memory_delete"
                                style="@style/HitchSettingsAction"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/settings_design_delete"
                                android:layout_marginStart="@dimen/hitch_space"
                                android:contentDescription="@string/settings_design_delete_sara" />
                        </LinearLayout>
                    </com.kotlinsun.hitchtalk.ui.PleosColumns>
                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/history"
                        style="@style/HitchSettingsAction"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/design_history_full"
                        android:gravity="start|center_vertical" />
                </LinearLayout>
                <com.kotlinsun.hitchtalk.ui.PleosColumns
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    style="@style/HitchSettingsRow"
                    android:id="@+id/settings_history_delete_row"
                    android:gravity="center_vertical"
                    android:baselineAligned="false"
                    app:columnMinWidth="@dimen/hitch_settings_fields_min_width">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            style="@style/HitchSectionTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/refine_delete_history_action" />
                        <TextView
                            style="@style/HitchCaption"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/design_clear_history_note" />
                    </LinearLayout>
                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/clear_history"
                        style="@style/HitchButton.Danger"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_design_clear_all"
                        android:layout_marginTop="0dp"
                        android:layout_gravity="end"
                        android:layout_marginStart="@dimen/hitch_space" />
                </com.kotlinsun.hitchtalk.ui.PleosColumns>
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/save"
                    style="@style/HitchButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_save"
                    android:layout_gravity="end"
                    android:layout_marginTop="@dimen/hitch_space" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:id="@+id/settings_data_section"
                    android:visibility="gone">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        style="@style/HitchSettingsRow">
                        <TextView
                            style="@style/HitchSectionTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/refine_account_section" />
                        <TextView
                            style="@style/HitchBody"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/settings_design_email"
                            android:id="@+id/settings_email"
                            android:layout_marginTop="@dimen/hitch_space" />
                        <TextView
                            style="@style/HitchCaption"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/refine_profile_section"
                            android:id="@+id/profile_summary"
                            android:layout_marginTop="@dimen/hitch_space" />
                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/logout"
                            style="@style/HitchSettingsAction"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/settings_logout"
                            android:layout_marginTop="@dimen/hitch_space" />
                    </LinearLayout>
                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/sync"
                        style="@style/HitchSettingsAction"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_sync"
                        android:layout_marginBottom="@dimen/hitch_space"
                        android:gravity="start|center_vertical" />
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        style="@style/HitchSettingsRow">
                        <TextView
                            style="@style/HitchSectionTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/settings_delete_account" />
                        <TextView
                            style="@style/HitchCaption"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/refine_delete_account_note" />
                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/delete_account"
                            style="@style/HitchButton.Danger"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/settings_delete_account"
                            android:layout_marginTop="@dimen/hitch_space"
                            android:layout_gravity="end" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </com.kotlinsun.hitchtalk.ui.SettingsPanelLayout>
</LinearLayout>
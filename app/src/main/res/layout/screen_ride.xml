<?xml version="1.0" encoding="utf-8"?>
<com.kotlinsun.hitchtalk.ui.RideViewport
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:clipToPadding="false">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingBottom="@dimen/hitch_space">
        <LinearLayout
            android:id="@+id/normal_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/title"
                style="@style/HitchTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/hitch_space"
                android:layout_weight="1"
                android:accessibilityHeading="true" />
            <TextView
                android:id="@+id/gear_status"
                style="@style/HitchBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
            <TextView
                android:id="@+id/clock"
                style="@style/HitchBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/hitch_space"
                android:background="@drawable/hitch_badge_brand"
                android:textColor="@color/hitch_accent" />
        </LinearLayout>
        <TextView
            android:id="@+id/lock_message"
            style="@style/HitchCaption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/hitch_space"
            android:visibility="gone" />
        <LinearLayout
            android:id="@+id/ride_stage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingVertical="@dimen/hitch_space">
            <TextView
                android:id="@+id/pickup_cue"
                style="@style/HitchBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/hitch_gutter"
                android:background="@drawable/hitch_zip_pickup_cue"
                android:drawableStart="@drawable/hitch_zip_music_note"
                android:drawablePadding="@dimen/hitch_space"
                android:textColor="@color/hitch_accent"
                android:visibility="gone" />
            <com.kotlinsun.hitchtalk.avatar.AvatarView
                android:id="@+id/travelerAvatar"
                android:layout_width="@dimen/hitch_avatar_large"
                android:layout_height="@dimen/hitch_avatar_large"
                android:background="@drawable/hitch_zip_avatar_halo"
                android:contentDescription="@string/hitch_alex"
                android:importantForAccessibility="noHideDescendants"
                app:avatarKind="alex" />
            <TextView
                android:id="@+id/traveler"
                style="@style/HitchHeading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/hitch_gutter"
                android:accessibilityHeading="true"
                android:gravity="center" />
            <TextView
                android:id="@+id/pickup_quote"
                style="@style/HitchBody"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/hitch_space"
                android:gravity="center"
                android:maxWidth="@dimen/hitch_form_max_width"
                android:visibility="gone" />
            <LinearLayout
                android:id="@+id/voice_indicator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/hitch_space"
                android:background="@drawable/hitch_zip_voice_pill"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/hitch_compact_button_padding"
                android:paddingVertical="@dimen/hitch_space">
                <ImageView
                    android:id="@+id/voice_wave"
                    android:layout_width="56dp"
                    android:layout_height="24dp"
                    android:layout_marginEnd="@dimen/hitch_space"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:src="@drawable/hitch_zip_wave"
                    app:tint="@color/hitch_accent" />
                <TextView
                    android:id="@+id/voice_status"
                    style="@style/HitchLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:accessibilityLiveRegion="polite"
                    android:gravity="center"
                    android:textColor="@color/hitch_accent" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/parked_controls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:visibility="gone">
            <LinearLayout
                android:id="@+id/quote_panel"
                style="@style/HitchCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/hitch_space"
                android:background="@drawable/hitch_card_gray"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="@dimen/hitch_callout_padding"
                android:visibility="gone">
                <TextView
                    android:id="@+id/quote"
                    style="@style/HitchBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center" />
                <TextView
                    android:id="@+id/quote_hint"
                    style="@style/HitchCaption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center" />
            </LinearLayout>
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/toggle_quote"
                style="@style/HitchButton.Tertiary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ride_show_quote"
                android:visibility="gone" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/hitch_gutter"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/pause"
                    style="@style/HitchButton.Secondary"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="@dimen/hitch_space"
                    android:layout_weight="1"
                    android:drawableStart="@drawable/hitch_zip_pause"
                    android:drawablePadding="@dimen/hitch_space"
                    android:paddingHorizontal="@dimen/hitch_space" />
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/drop_off"
                    style="@style/HitchButton"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1.8"
                    android:drawableStart="@drawable/hitch_zip_exit"
                    android:drawablePadding="@dimen/hitch_space"
                    android:drawableTint="@color/hitch_on_accent"
                    android:paddingHorizontal="@dimen/hitch_space"
                    android:text="@string/hitch_ride_drop_off" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/recovery_actions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/hitch_space"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/retry"
                    style="@style/HitchButton.Compact"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="@dimen/hitch_space"
                    android:layout_weight="1"
                    android:paddingHorizontal="@dimen/hitch_space"
                    android:text="@string/voice_retry"
                    android:visibility="gone" />
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/cancel_ride"
                    style="@style/HitchButton.Tertiary"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:paddingHorizontal="@dimen/hitch_space"
                    android:text="@string/design_cancel_ride"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</com.kotlinsun.hitchtalk.ui.RideViewport>

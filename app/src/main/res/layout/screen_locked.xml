<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical">
    <TextView
        style="@style/HitchBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/hitch_accent"
        android:text="@string/hitch_brand"
        android:background="@drawable/hitch_badge_brand" />
    <TextView
        android:id="@+id/title"
        style="@style/HitchHeading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:accessibilityHeading="true"
        android:maxWidth="@dimen/hitch_form_max_width"
        android:layout_marginTop="@dimen/hitch_space" />
    <TextView
        style="@style/HitchCallout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/hitch_gutter"
        android:gravity="center"
        android:maxWidth="@dimen/hitch_form_max_width"
        android:background="@drawable/hitch_callout_warning"
        android:textColor="@color/hitch_warning"
        android:text="@string/hitch_wait_for_park" />
</LinearLayout>

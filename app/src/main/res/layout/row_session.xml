<?xml version="1.0" encoding="utf-8"?>
<com.kotlinsun.hitchtalk.ui.PleosColumns
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/HitchCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/hitch_space"
    android:baselineAligned="false"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    app:columnMinWidth="@dimen/hitch_action_row_min_width">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/session_title"
            style="@style/HitchSectionTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/session_details"
            style="@style/HitchCaption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/hitch_space" />

        <TextView
            android:id="@+id/session_status"
            style="@style/HitchBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/hitch_space" />
    </LinearLayout>

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/open_report"
        style="@style/HitchButton.Compact"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/hitch_gutter"
        android:text="@string/history_open_report" />
</com.kotlinsun.hitchtalk.ui.PleosColumns>

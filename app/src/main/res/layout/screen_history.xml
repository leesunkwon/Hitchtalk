<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <com.kotlinsun.hitchtalk.ui.ContentColumn
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingBottom="@dimen/hitch_space"
        app:contentMaxWidth="@dimen/hitch_detail_max_width">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/back"
                style="@style/HitchButton.Tertiary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/hitch_space"
                android:contentDescription="@string/secondary_back"
                android:text="@string/secondary_back_symbol" />

            <TextView
                style="@style/HitchTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:accessibilityHeading="true"
                android:text="@string/history_title" />
        </LinearLayout>

        <TextView
            style="@style/HitchCaption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/hitch_space"
            android:text="@string/history_description" />

        <com.kotlinsun.hitchtalk.ui.PleosColumns
            style="@style/HitchCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/hitch_gutter"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:columnMinWidth="@dimen/hitch_action_row_min_width">

            <TextView
                style="@style/HitchSectionTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:labelFor="@id/history_filter"
                android:text="@string/history_filter" />

            <Spinner
                android:id="@+id/history_filter"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/hitch_gutter"
                android:layout_weight="2"
                android:background="@drawable/hitch_spinner_field"
                android:minHeight="@dimen/hitch_header_button_height"
                android:paddingStart="@dimen/hitch_gutter"
                android:paddingEnd="44dp"
                android:popupBackground="@drawable/hitch_card_white"
                android:spinnerMode="dropdown" />
        </com.kotlinsun.hitchtalk.ui.PleosColumns>

        <TextView
            android:id="@+id/history_empty"
            style="@style/HitchCallout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/hitch_gutter"
            android:accessibilityLiveRegion="polite"
            android:text="@string/refine_history_empty"
            android:visibility="gone" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/history_retry"
            style="@style/HitchButton.Secondary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="@dimen/hitch_space"
            android:text="@string/voice_retry"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/history_rows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/hitch_space"
            android:orientation="vertical" />
    </com.kotlinsun.hitchtalk.ui.ContentColumn>
</ScrollView>
